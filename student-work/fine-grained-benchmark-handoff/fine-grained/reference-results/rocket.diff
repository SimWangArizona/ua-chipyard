@@ -160,6 +163,46 @@ class ALU(implicit p: Parameters) extends AbstractALU()(p) {
   val rotout_l = Reverse(rotout_r)
   val rotout = Mux(io.fn(0), rotout_r, rotout_l) | Mux(io.fn(0), shout_l, shout_r)
 
+  // Packed native DP: in1 = {c32, a32}, in2.low32 = b32.
+  // Use a dedicated 32-bit sum: packed c must not participate in arithmetic.
+  val useFineGrainedDP = coreParams match {
+    case r: RocketCoreParams => r.useFineGrainedDP
+    case _ => false
+  }
+  val fineGrainedDPResults = if (useFineGrainedDP) {
+    require(xLen == 64, "Native packed DP requires RV64")
+    val sum32 = Wire(UInt(32.W))
+    sum32 := io.in1(31,0) + io.in2(31,0)
+    val c32 = io.in1(63,32)
+    val sumLess = sum32.asSInt < c32.asSInt
+    val max32 = Mux(sumLess, c32, sum32)
+    val min32 = Mux(sumLess, sum32, c32)
+    Seq(
+      FN_FG_ADD_MAX -> Cat(Fill(32, max32(31)), max32),
+      FN_FG_ADD_MIN -> Cat(Fill(32, min32(31)), min32)
+    )
+  } else Nil
+
+  // Four signed INT8 lanes; accumulation wraps only at the final 32 bits.
+  val useFineGrainedDot = coreParams match {
+    case r: RocketCoreParams => r.useFineGrainedDot
+    case _ => false
+  }
+  val fineGrainedDotResults = if (useFineGrainedDot) {
+    require(xLen == 64, "Native packed dot requires RV64")
+    val products = (0 until 4).map { i =>
+      val a = io.in1(8*i+7, 8*i).asSInt
+      val b = io.in2(8*i+7, 8*i).asSInt
+      a * b // 16-bit signed product
+    }
+    val pair01 = products(0) +& products(1) // 17 bits
+    val pair23 = products(2) +& products(3) // 17 bits
+    val dot18 = pair01 +& pair23 // 18 bits, includes +65536
+    val accumulated = io.in1(63,32).asSInt +& dot18 // 33 bits
+    val result32 = accumulated.asUInt(31,0)
+    Seq(FN_FG_DOT4_ACC -> Cat(Fill(32, result32(31)), result32))
+  } else Nil
+
   val out = MuxLookup(io.fn, shift_logic_cond)(Seq(
     FN_ADD -> io.adder_out,
     FN_SUB -> io.adder_out
@@ -171,7 +214,7 @@ class ALU(implicit p: Parameters) extends AbstractALU()(p) {
     FN_MINU -> maxmin_out,
     FN_ROL -> rotout,
     FN_ROR -> rotout,
-  ) else Nil))
+  ) else Nil) ++ fineGrainedDPResults ++ fineGrainedDotResults)
 
 
   io.out := out
